{
  "name": "card-overview-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "node -e \"fs.existsSync('.env')||fs.copyFileSync('.env.example','.env')\" && npm run db:up && npm run db:migrate && npm run db:seed",
    "dev": "tsx watch --env-file=.env src/server.ts | pino-pretty --translateTime SYS:HH:MM:ss.l --ignore pid,hostname",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"for (const dir of ['openapi', 'db/migrations']) fs.cpSync(dir, 'dist/' + dir, { recursive: true })\"",
    "start:prod": "node dist/src/server.js",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "spec:lint": "redocly lint openapi/openapi.yaml",
    "spec:types": "openapi-typescript openapi/openapi.yaml -o src/generated/api.ts",
    "mock": "prism mock openapi/openapi.yaml",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "token": "tsx --env-file=.env scripts/token.ts",
    "spec:check": "npm run spec:lint && npm run spec:types && git diff --exit-code src/generated/api.ts",
    "token:docker": "docker compose exec api node dist/scripts/token.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.62.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  }
}
